# ============================================================================
# CppUI CMake Package Configuration File
# Enables downstream consumers to use: find_package(CppUI CONFIG REQUIRED)
# ============================================================================

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Platform threading and system library dependencies
if(NOT WIN32)
    find_dependency(Threads)
    if(@CPPUI_HAS_X11@)
        find_dependency(X11)
    endif()
endif()

# Google Skia 2D rendering core dependency (if enabled at build time)
if(@CPPUI_HAS_SKIA@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Skia)
endif()

# Import targets
include("${CMAKE_CURRENT_LIST_DIR}/CppUITargets.cmake")

check_required_components(CppUI)
